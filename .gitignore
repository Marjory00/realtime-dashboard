# ----------------------------------------
# 1. Project Dependencies & Build Artifacts
# ----------------------------------------

# Python/Backend dependencies
/backend/venv/              # Python virtual environment folder
__pycache__/
*.pyc
*.swp
*.egg-info/
.pytest_cache/

# Node/Frontend dependencies and build output
/frontend/node_modules
/frontend/build
npm-debug.log*
yarn-debug.log*
/frontend/package-lock.json


# Node lock files
package-lock.json           # Explicitly requested
yarn.lock

# ----------------------------------------
# 2. Configuration & Sensitive Files
# ----------------------------------------

# Environment/Secret files
*.env                       # Generic environment file (.env, .env.development, etc.)
.env.local                  # React/CRA specific local environment file
/backend/.env               # Specific backend environment file
/frontend/.env              # Specific frontend environment file
config.json                 # Common file for sensitive configurations
secrets.yaml
*.key                       # Private keys
*.pem

# Database/Storage files (if used locally)
*.sqlite
*.db
*.csv.bak

# ----------------------------------------
# 3. Common Server/Executable Files (Excluding source code)
# ----------------------------------------

server.js                   # Explicitly requested (if used outside of core source files)

# ----------------------------------------
# 4. OS/Editor Specific Files
# ----------------------------------------

# VS Code specific files
.vscode/

# Windows/macOS/Linux
Thumbs.db
.DS_Store